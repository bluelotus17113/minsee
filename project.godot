; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MinSee"
config/description="JRPG por turnos pixel art (64x64) inspirado en Trails"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
BattleLoader="*res://scripts/autoload/battle_loader.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
MapManager="*res://scripts/autoload/map_manager.gd"
MusicManager="*res://scripts/autoload/music_manager.gd"
Story="*res://scripts/autoload/story.gd"
CutsceneRunner="*res://scripts/autoload/cutscene_runner.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/minsee_database/plugin.cfg", "res://addons/minsee_map/plugin.cfg")

