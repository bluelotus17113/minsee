[gd_resource type="Resource" script_class="SkillTreeData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/skill_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://scripts/data/skill_tree_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/skills/ice_lance.tres" id="3_ice"]
[ext_resource type="Resource" path="res://data/skills/holy_smite.tres" id="4_holy"]

[sub_resource type="Resource" id="Entry_ice"]
script = ExtResource("2_entry")
skill = ExtResource("3_ice")
sp_cost = 1
note = "Magia de hielo, útil contra goblins de fuego."

[sub_resource type="Resource" id="Entry_holy"]
script = ExtResource("2_entry")
skill = ExtResource("4_holy")
sp_cost = 2
note = "Magia sagrada con AoE."

[resource]
script = ExtResource("1_tree")
tree_name = "Senda de Min"
description = "Camino arcano de Min: hielo y luz."
entries = Array[Resource]([SubResource("Entry_ice"), SubResource("Entry_holy")])
